{
  "manifest_version": 3,
  "name": "IELTS Lexi – Từ điển & Flashcard IELTS",
  "short_name": "IELTS Lexi",
  "version": "1.0.0",
  "description": "Bấm đúp vào từ bất kỳ để xem phiên âm, nghĩa tiếng Việt, hình ảnh; lưu vào flashcard kèm câu ngữ cảnh; nhắc ôn tập mỗi ngày.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "IELTS Lexi", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "notifications", "contextMenus"],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://api.mymemory.translated.net/*",
    "https://en.wikipedia.org/*"
  ],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "web_accessible_resources": [{ "resources": ["icons/*"], "matches": ["http://*/*", "https://*/*"] }],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+L", "mac": "Alt+L" }, "description": "Mở IELTS Lexi" }
  }
}
